/* Universal Reset & Variables */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

:root {
  --primary-color: #4f46e5;
  --primary-hover: #4338ca;
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --text-main: #1f2937;
  --text-muted: #6b7280;
  --border-color: #d1d5db;
}

/* Centering the Form layout */
body {
  background-color: var(--bg-color);
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
}

/* Card Container */
.form-container {
  background-color: var(--card-bg);
  padding: 40px;
  border-radius: 12px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  width: 100%;
  max-width: 500px;
}

.form-container h2 {
  color: var(--text-main);
  margin-bottom: 8px;
  font-size: 28px;
  font-weight: 700;
}

.form-container p {
  color: var(--text-muted);
  font-size: 14px;
  margin-bottom: 24px;
}

/* Input Fields and Labels */
.input-group {
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
}

.input-group label {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6px;
}

.input-group input {
  padding: 12px 16px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  font-size: 15px;
  outline: none;
  transition: all 0.2s ease-in-out;
}

/* Input Interactions */
.input-group input:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
}

/* Multi-column Rows (Password fields side by side) */
.form-row {
  display: flex;
  gap: 16px;
}

.form-row .input-group {
  flex: 1;
}

/* Checkbox alignment */
.checkbox-group {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
}

.checkbox-group input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: var(--primary-color);
  cursor: pointer;
}

.checkbox-group label {
  font-size: 14px;
  color: var(--text-muted);
}

.checkbox-group a {
  color: var(--primary-color);
  text-decoration: none;
}

/* Submission Button */
.submit-btn {
  width: 100%;
  padding: 14px;
  background-color: var(--primary-color);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s;
}

.submit-btn:hover {
  background-color: var(--primary-hover);
}

/* Footer styling */
.form-footer {
  text-align: center;
  margin-top: 20px !important;
  font-size: 14px;
}

.form-footer a {
  color: var(--primary-color);
  text-decoration: none;
  font-weight: 600;
}

.form-footer a:hover {
  text-decoration: underline;
}

/* Responsive Breakpoints (Mobile fixes) */
@media (max-width: 480px) {
  .form-container {
    padding: 24px;
  }
  
  .form-row {
    flex-direction: column;
    gap: 0;
  }
}
